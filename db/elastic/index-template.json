{
  "index_patterns": ["weather-processed-*", "weather-compare-*", "weather-raw-*", "stations-*"],
  "template": {
    "settings": {
      "number_of_shards": 1,
      "number_of_replicas": 1,
      "refresh_interval": "1s"
    },
    "mappings": {
      "dynamic": false,
      "properties": {
        "doc_id": { "type": "keyword" },

        "provider": { "type": "keyword" },
        "source_id": { "type": "keyword" },
        "station_id": { "type": "keyword" },

        "timestamp": { "type": "date" },
        "processed_at": { "type": "date" },

        "temperature": { "type": "float" },
        "temperature_out": { "type": "float" },
        "temperature_in": { "type": "float" },

        "relative_humidity": { "type": "integer" },
        "relative_humidity_out": { "type": "integer" },
        "relative_humidity_in": { "type": "integer" },

        "dew_point": { "type": "float" },
        "pressure_msl": { "type": "float" },
        "precipitation": { "type": "float" },

        "wind_speed": { "type": "float" },
        "wind_speed_kmh": { "type": "float" },

        "wind_direction": { "type": "integer" },
        "wind_dir_deg": { "type": "integer" },
        "wind_dir_text": { "type": "keyword" },

        "wind_gust_speed": { "type": "float" },
        "wind_gust_direction": { "type": "integer" },

        "cloud_cover": { "type": "integer" },
        "sunshine": { "type": "float" },
        "solar": { "type": "float" },
        "visibility": { "type": "integer" },

        "condition": { "type": "keyword" },
        "icon": { "type": "keyword" },

        "rain_rate": { "type": "float" },
        "rain_day": { "type": "float" },

        "battery_v": { "type": "float" },
        "sun_uv": { "type": "integer" },
        "sun_rad": { "type": "integer" },

        "condition_rule": { "type": "integer" },
        "condition_val": { "type": "integer" }
      }
    }
  }
}
